# Pinned docker / endpoint defaults.
# Source: docs/ops/docker-defaults.md and the contract lines in final-run3/profile.args.
# Experiment runners source this file. They do not call lib/start.sh or final-run3/start.sh.

# lib/flag-check.sh and lib/start.sh use vllm/vllm-openai:nightly when VLLM_IMAGE
# is unset. This suite exports the graded digest unless the operator already set one.
VLLM_IMAGE_PIN='vllm/vllm-openai@sha256:cb12c3016938a4ee98ed176ac833984089460689a0982cff4b5a60bb45b3cded'
VLLM_IMAGE="${VLLM_IMAGE:-$VLLM_IMAGE_PIN}"

# vLLM version recorded for that digest: 0.32.1rc1.dev361+g83c078d95

CONTAINER_NAME="${CONTAINER_NAME:-mango-vllm}"
PORT="${PORT:-8000}"
BIND="${BIND:-0.0.0.0}"
# How long --launch waits for local http://127.0.0.1:$PORT/v1/models (same default as lib/start.sh).
WAIT_SECONDS="${WAIT_SECONDS:-900}"

# Empty means the card default (~400 W on the graded VM). This suite does not set a cap.
GREENMIND_POWER_W="${GREENMIND_POWER_W-}"

MODEL_ID='CMKL/MANGO1.5-Qwen3.5-9B-AWQ-W4A16-mtp'
SERVED_MODEL_NAME='mango1.5-awq-w4a16'

LOCAL_BASE_URL="http://127.0.0.1:${PORT}/v1"
PUBLIC_BASE_URL='http://103.153.118.56:8000/v1'

# Final-track constants (scoring_criteria.md). These are grader baselines, not a result.
ETA_BASE='0.00163'
ENERGY_K='3'
REF_MACRO='0.878'
TTFT_SLO_BASE_S='0.5'
TTFT_SLO_PER_1K_S='0.25'
TPOT_SLO_S='0.050'
